# Puerto del servidor web
PORT=3000

# ── Supabase ──────────────────────────────────────────────────────────
# URL del proyecto Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave anónima (para operaciones públicas)
SUPABASE_ANON_KEY=eyJ...

# Clave de service_role (para operaciones admin: uploads, manages)
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── PostgreSQL (Supabase pooler) ──────────────────────────────────────
# URL de conexión al pooler de Supabase (Transaction mode, puerto 6543)
DATABASE_URL=postgres://postgres.[ref]:[password]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# Variables alternativas (si no se usa DATABASE_URL):
# DB_HOST=db.[ref].supabase.co
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=tu-password
# DB_NAME=postgres

# ── Autenticación ─────────────────────────────────────────────────────
# Clave del panel de administración
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar las sesiones (JWT). En producción usá una clave larga y aleatoria.
# Obligatorio en Vercel: si no se define, se genera una aleatoria por arranque y
# las sesiones se invalidan en cada cold start.
JWT_SECRET=cambia-esta-clave-jwt

# Marcar la cookie de sesión como "secure" (solo HTTPS). Activalo en producción.
# COOKIE_SECURE=false

# Usuario administrador inicial (se crea en la primera ejecución)
# ADMIN_USER=admin

# ── Formulario de encuentro ───────────────────────────────────────────
# Enlace al formulario de inscripción al encuentro.
ENCUENTRO_FORM_URL=

# ── WhatsApp (API no oficial, vía Baileys) ────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PREFIX=549

# ── SMTP ──────────────────────────────────────────────────────────────
# Si SMTP_HOST está vacío, el envío se simula y queda registrado en logs/emails.log.
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=cuenta@tudominio.com
# SMTP_PASS=contraseña
# EMAIL_FROM="Inscripciones <cuenta@tudominio.com>"

# ── Imágenes para PDFs de acreditación ───────────────────────────────
# Rutas relativas a la carpeta del proyecto.
# ENCUENTRO_LOGO_IMG=public/logo.png
# ENCUENTRO_PERSONAJE_IMG=public/personaje.png

# ── Semillas ──────────────────────────────────────────────────────────
# Cargar talleres de ejemplo si la tabla está vacía (true/false).
# Si vas a cargar tus talleres desde el panel, dejalo en false.
SEED_ON_START=false

# Puerto del servidor web
PORT=3000

# ── PostgreSQL local ────────────────────────────────────────────────
# URL de conexión directa (recomendado para red local)
DATABASE_URL=postgres://postgres:postgres@host:5432/inscripciones?sslmode=disable

# Variables alternativas (si no se usa DATABASE_URL):
# DB_HOST=host
# DB_PORT=5432
# DB_USER=postgres
# DB_PASSWORD=postgres
# DB_NAME=inscripciones

# ── Supabase (Storage persistente en Vercel) ──────────────────────────
# En Vercel el FS es efímero: las fotos de ponentes DEBEN ir a Supabase.
# Si SUPABASE_URL está vacío, las fotos se guardan en public/uploads (solo para dev local, se pierden en Vercel).
# SUPABASE_URL=https://tu-proyecto.supabase.co
# SUPABASE_ANON_KEY=eyJ...
# SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Nombre del bucket (default: ponentes-fotos) y prefijo ponentes/
# STORAGE_BUCKET=ponentes-fotos
# UPLOADS_DIR solo para dev local con volumen persistente (ignorado en Vercel)
# UPLOADS_DIR=public/uploads
# UPLOADS_DIR_LEGACY=public/uploads/ponentes

# ── Autenticación ─────────────────────────────────────────────────────
# Clave del panel de administración
ADMIN_PASSWORD=cambia-esta-clave

# Secreto para firmar las sesiones (JWT). En producción usá una clave larga y aleatoria.
# Obligatorio en Vercel: si no se define, se genera una aleatoria por arranque y
# las sesiones se invalidan en cada cold start.
JWT_SECRET=cambia-esta-clave-jwt

# Marcar la cookie de sesión como "secure" (solo HTTPS). Activalo en producción.
# COOKIE_SECURE=false

# Usuario administrador inicial (se crea en la primera ejecución)
# ADMIN_USER=admin

# ── Inscripción al encuentro (nativa, sin Google) ──────────────────────
# Ahora el formulario se hace directamente en / (POST /api/encuentro).
# ENCUENTRO_ALIAS es el alias/CBU para transferencias que se muestra en el form.
# ENCUENTRO_ALIAS_LEYENDA es texto explicativo (ej: "Titular: ... Banco: ...").
# Las dos variables de abajo quedan solo por compatibilidad / migración:
# ENCUENTRO_FORM_URL ya no se usa (el aviso ahora abre el form interno).
# GOOGLE_SHEETS_API_KEY solo si aún usás el endpoint legacy POST /api/admin/insertar-datos.
# ENCUENTRO_FORM_URL=
# GOOGLE_SHEETS_API_KEY=cambia-esta-clave-sheets
ENCUENTRO_ALIAS=dramatiza.salta.mp
ENCUENTRO_ALIAS_LEYENDA=Titular: Asociación Dramatiza Salta - CBU: 0000000000000000000000 - Banco: Mercado Pago
ENCUENTRO_TRANSFERENCIA_TITULO=Datos para la transferencia
ENCUENTRO_TRANSFERENCIA_DESCRIPCION=Realizá la transferencia al alias indicado y subí el comprobante (imagen o PDF, máx 8 MB).
# Opciones de pago que se muestran en el form (separadas por |). Ej: "3 cuotas de $30.000 (Total $90.000)|2 cuotas de $35.000 y 1 de $40.000 (Total $110.000)|2 cuotas de $65.000 (Total $130.000)"
# Si se deja vacío, se generan automáticamente según fecha (ver db.js definirPlanAutomatico).
# ENCUENTRO_OPCIONES_PAGO=

# ── WhatsApp (API no oficial, vía Baileys) ────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_PREFIX=549

# ── SMTP ──────────────────────────────────────────────────────────────
# Si SMTP_HOST está vacío, el envío se simula y queda registrado en logs/emails.log.
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=cuenta@tudominio.com
# SMTP_PASS=contraseña
# EMAIL_FROM="Inscripciones <cuenta@tudominio.com>"

# ── Imágenes para PDFs de acreditación ───────────────────────────────
# Rutas relativas a la carpeta del proyecto.
# ENCUENTRO_LOGO_IMG=public/logo.png
# ENCUENTRO_PERSONAJE_IMG=public/personaje.png

# ── Semillas ──────────────────────────────────────────────────────────
# Cargar talleres de ejemplo si la tabla está vacía (true/false).
# Si vas a cargar tus talleres desde el panel, dejalo en false.
SEED_ON_START=false

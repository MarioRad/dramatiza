# Puerto del servidor web
PORT=3000

# Motor de base de datos: "mysql" o "postgres"
DB_TYPE=mysql

# Configuración MySQL (se ignora si DB_TYPE=postgres)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inscripciones

# Alternativa para PostgreSQL (si DB_TYPE=postgres podés usar esta URL
# en vez de las variables DB_* de arriba):
# DATABASE_URL=postgres://usuario:clave@localhost:5432/inscripciones

# Clave del panel de administración
ADMIN_PASSWORD=cambia-esta-clave

# Marcar la cookie de sesión como "secure" (solo HTTPS). Activalo en producción.
# COOKIE_SECURE=false

# Usuario administrador inicial (se crea en la primera ejecución)
# ADMIN_USER=admin

# Enlace al formulario de inscripción al encuentro. Se muestra como aviso
# cuando el DNI de una persona no figura en el listado del encuentro.
ENCUENTRO_FORM_URL=

# WhatsApp (API no oficial, vía Baileys). Al activarlo, la app muestra un QR
# en la consola para vincular un número de teléfono. Riesgo: bloqueo de la
# cuenta de WhatsApp si se hace spam o uso intensivo.
WHATSAPP_ENABLED=false
# Prefijo de país (Argentina: 549) que se antepone a teléfonos locales.
WHATSAPP_PREFIX=549

# Correo de confirmación. Por ahora el envío se simula y queda registrado en
# logs/emails.log. Para envío real configurar SMTP en una versión posterior.

# --- Servidor SMTP para el envío real de los emails ---
# Si SMTP_HOST está vacío, el envío se simula y solo queda registrado en
# logs/emails.log.
# SMTP_HOST=smtp.tudominio.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=cuenta@tudominio.com
# SMTP_PASS=contraseña
# EMAIL_FROM="Inscripciones <cuenta@tudominio.com>"

# Imágenes que se incluyen en la acreditación (QR + PDF). Rutas relativas a la
# carpeta del proyecto. Si el archivo no existe, se omite la imagen.
# ENCUENTRO_LOGO_IMG=public/logo.png
# ENCUENTRO_PERSONAJE_IMG=public/personaje.png

# Cargar talleres de ejemplo si la tabla está vacía (true/false).
# Si vas a cargar tus talleres desde el panel, dejalo en false.
SEED_ON_START=false
